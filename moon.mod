name = "mizchi/playwright"

version = "0.3.9"

import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/regexp@0.3.5",
  "mizchi/webdriver@0.2.4",
  "moonbitlang/x@0.4.40",
}

